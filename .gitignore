# ---------------------------------------------------------------------------
# 依赖与构建产物
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# 运行时数据 —— 绝不提交
#
# data/ 里有 SQLite 数据库（含加密后的交易所凭据）、主密钥文件、服务日志。
# 主密钥和数据库放在一起就等于明文凭据：拿到这两样就能解密出交易所 API Secret。
# ---------------------------------------------------------------------------
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.master.key
*.db

# ---------------------------------------------------------------------------
# 密钥与凭据
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.*
!.env.example

# 私钥 / 证书
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
known_hosts

# 凭据类配置文件（各家云厂商 / CLI 的常见命名）
.aws/
.ssh/
.gnupg/
.npmrc
.pypirc
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# 部署者本地配置 —— 每台机器不同，不该进仓库
# ---------------------------------------------------------------------------
deploy.local.ps1
deploy.local.sh

# 站点专属敏感信息规则（域名 / IP / 主机名）。
# 钩子脚本读取它，但它本身绝不入库 —— 否则就自相矛盾了。
# 模板见 sensitive-patterns.example.txt
sensitive-patterns.txt

# ---------------------------------------------------------------------------
# 日志与临时产物
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-error.log*
_deploy.tar.gz
*.tar.gz

# ---------------------------------------------------------------------------
# AI 编码代理的会话记录
#
# 这些目录里是**完整的对话历史**，往往包含粘贴过的密钥、服务器地址、内部讨论。
# 它们不属于项目，而且极易被无意识地提交 —— 是最容易被忽略的一类泄漏源。
# ---------------------------------------------------------------------------
.dsh/
.claude/
.cursor/
.continue/
.aider*
.codeium/
.windsurf/
copilot/
*.chatlog
*.session.json

# ---------------------------------------------------------------------------
# 编辑器 / 操作系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# 大体积可再生的研究资料
#
# 可由 docs/research/README.md 中记录的来源 URL 重新获取，本地留作可检索参考。
# ---------------------------------------------------------------------------
docs/research/vendor/

# UI 冒烟检查生成的截图（scripts/ui-smoke.mjs）
packages/web/ui-smoke/

# 一次性的视觉方向对比页（给维护者看，不属于项目产物）
_ui-directions.html
