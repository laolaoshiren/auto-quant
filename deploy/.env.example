# =============================================================================
# auto-quant 运行配置（Docker 部署）
#
# `up.sh` 会在首次运行时自动生成这个文件（并填充随机密钥），
# 所以**通常你不需要手动创建它**。这个模板是给你改配置时对照用的。
#
#   cp .env.example .env   # 手动创建（不推荐，密钥需要你自己生成）
# =============================================================================


# -----------------------------------------------------------------------------
# 必填：三个密钥
#
# up.sh 会自动生成。**如果手动创建这个文件，这三项必须自己填。**
# 生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
#
# ⚠️ 不要留空让系统自动生成。首次启动自动生成的主密钥会写进 data/ 目录，
#    而 data/ 里同时存着加密后的交易所凭据 —— 两样放在一起等于明文凭据。
# -----------------------------------------------------------------------------
MASTER_KEY=
JWT_SECRET=

# 首次启动创建 owner 账户用的密码。留空时会自动生成并打印到日志（只显示一次）。
# 建议直接设成一个你自己记得住的强密码，省去第一次去翻日志。
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# 交易环境 —— 最容易出错的一项
#
# false = 实盘（真实资金）    true = 币安 Demo 模拟盘
#
# 两者**界面完全一样**，配错了不会报错，只是交易悄悄跑到错误的环境上。
# 首次部署建议先保持 true 跑通，确认无误后再改 false。
# -----------------------------------------------------------------------------
BINANCE_USE_TESTNET=true

# true 时只模拟下单、不碰交易所（用于纯演示）
DRY_RUN=false

# 全局熔断：true 时服务端拒绝启动任何机器人
GLOBAL_TRADING_DISABLED=false


# -----------------------------------------------------------------------------
# 网络与端口
# -----------------------------------------------------------------------------
PORT=3200

# 宿主机绑定地址。
#   127.0.0.1 —— 只本机可访问（默认，最安全；公网访问请走反向代理）
#   0.0.0.0   —— 公网可直接访问（除非前面有防火墙，否则不要这么设）
BIND_ADDRESS=127.0.0.1

# 日志级别：debug | info | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# 镜像与存储
# -----------------------------------------------------------------------------
# 锁定版本时改成具体 tag，例如 ghcr.io/laolaoshiren/auto-quant:v0.2.0
AUTOQUANT_IMAGE=ghcr.io/laolaoshiren/auto-quant:latest

# 容器内数据目录。**不要改**，改了要和 docker-compose.yml 的卷映射一起改。
DATA_DIR=./data
DB_FILE=autoquant.sqlite


# -----------------------------------------------------------------------------
# 可选：HTTP 代理
#
# 服务器所在网络访问币安或 LLM 接口受限时使用。
# 注意：币安对 API Key 有 IP 白名单，走代理后出口 IP 变了，
#       需要在币安后台把代理的出口 IP 加进白名单。
# -----------------------------------------------------------------------------
# HTTPS_PROXY=http://127.0.0.1:7890
